# Docker Compose reads this file. Copy it to .env and replace the token.
TZ=Asia/Shanghai

# Port exposed by the NAS. Use 127.0.0.1:5080 when a NAS reverse proxy is used.
GOLD_HOST_PORT=5080

# Used by all /api/push/* and /api/service/status management endpoints.
GOLD_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional runtime storage path for channel settings entered through the admin UI.
# Docker Compose configures this automatically and persists it in a named volume.
# GOLD_PUSH_CONFIG_PATH=data/push_channels.json

# Optional: comma-separated origins permitted to call the API directly from a browser.
# Keep this empty when the frontend uses a same-origin reverse proxy.
# Example: GOLD_CORS_ALLOWED_ORIGINS=https://frontend.example.com
GOLD_CORS_ALLOWED_ORIGINS=
