# Docker Compose reads this file. Copy it to .env and replace the token.
TZ=Asia/Shanghai

# Port exposed by the NAS. Use 127.0.0.1:5080 when a NAS reverse proxy is used.
GOLD_HOST_PORT=5080

# Used by all /api/push/* and /api/service/status management endpoints.
GOLD_ADMIN_TOKEN=replace-with-a-long-random-secret
